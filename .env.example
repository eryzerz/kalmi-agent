OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=openai/gpt-4o

# Telemetry (optional — set to send traces to Jaeger)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# MCP servers to connect to (comma-separated list)
MCP_SERVERS=cognee,crw

# Cognee MCP server
MCP_COGNEE_TRANSPORT=sse
MCP_COGNEE_URL=http://localhost:8001/sse
# MCP_COGNEE_API_KEY=your-api-key

# CRW (FastCRW) MCP server
MCP_CRW_TRANSPORT=http
MCP_CRW_URL=http://localhost:3001/mcp
